        <mxCell id="s2_title" value="PCA Dimensionality Reduction (2_pca_generate_entries.py)" style="text;html=0;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#2E7D32;strokeColor=none;fillColor=none;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="220" y="310" width="450" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s2a" value="Load dataset.csv&#xa;Clean NaN / Inf" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="20" y="340" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2b" value="Fit sklearn PCA on&#xa;quantized features&#xa;→ matrix A and&#xa;intercept b" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="170" y="340" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2c" value="Select K components&#xa;(user-specified k,&#xa;b = 32 bits)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="360" y="340" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2d" value="Fixed-point scale&#xa;SCALE = 2^b - 1&#xa;PC accumulator&#xa;is b-bit integer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="540" y="340" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2e" value="Expand A row by&#xa;input feature i&#xa;(additive form):&#xa;PC_j = Σ_i A_ji⋅x_i + b_j" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="700" y="340" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2f" value="For each feature i,&#xa;enumerate its&#xa;distinct quantized&#xa;values v" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="430" width="145" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2g" value="Precompute scaled&#xa;contributions:&#xa;d_j(i, v) = A_ji⋅v⋅SCALE" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="195" y="430" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2h" value="Emit one single-field&#xa;range table per&#xa;feature i, keyed on v" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="355" y="430" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2i" value="Action: accumulator&#xa;PC_j += d_j(i, v)&#xa;for j = 1..K&#xa;(K codes per packet)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A5D6A7;fontSize=15;strokeWidth=1.5;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="527.5" y="430" width="192.5" height="70" as="geometry" />
        </mxCell>
